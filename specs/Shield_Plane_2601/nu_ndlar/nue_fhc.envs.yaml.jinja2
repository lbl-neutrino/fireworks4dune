{% set modes = ['noFar_noShield',
                'noFar_withShield',
                'withFar_noShield',
                'withFar_withShield'] %}

{% for mode in modes %}

-
  name: 'Shield_Plane_2601.nue_fhc.larnd.{{mode}}'
  env:
    <<: *common_larnd_ndlar_{{mode}}
    ND_PRODUCTION_CONVERT2H5_NAME: 'MiniProdN5p1_NDComplex_FHC.convert2h5.ndlarfid.sanddrift.nueelastic.singles'

-
  name: 'Shield_Plane_2601.nue_fhc.flow.{{mode}}'
  env:
    <<: *common_flow_ndlar
    ND_PRODUCTION_IN_NAME: 'Shield_Plane_2601.nue_fhc.larnd.{{mode}}'

-
  name: 'Shield_Plane_2601.nue_fhc.flow2supera.{{mode}}'
  env:
    <<: *common_flow2supera_ndlar
    ND_PRODUCTION_IN_NAME: 'Shield_Plane_2601.nue_fhc.flow.{{mode}}'

-
  name: 'Shield_Plane_2601.nue_fhc.spine.{{mode}}'
  env:
    <<: *common_spine_ndlar
    ND_PRODUCTION_IN_NAME: 'Shield_Plane_2601.nue_fhc.flow.{{mode}}'

{% endfor %}
