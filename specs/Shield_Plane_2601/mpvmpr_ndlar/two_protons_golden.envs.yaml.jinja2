{% set modes = ['noFar_noShield',
                'noFar_withShield',
                'withFarSeg_noShield'] %}

-
  name: 'Shield_Plane_2601.two_protons_golden.edep'
  env:
    <<: *common_edep_ndlar
    ND_PRODUCTION_MPVMPR_CONFIG: 'mpvmpr/Shield_Plane_2601/ndlar_geom/two_protons_golden.yaml'

-
  name: 'Shield_Plane_2601.two_protons_golden.convert2h5'
  env:
    <<: *common_convert2h5
    ND_PRODUCTION_SINGLE_NAME: 'Shield_Plane_2601.two_protons_golden.edep'

{% for mode in modes %}

-
  name: 'Shield_Plane_2601.two_protons_golden.larnd.{{mode}}'
  env:
    <<: *common_larnd_ndlar_{{mode}}
    ND_PRODUCTION_CONVERT2H5_NAME: 'Shield_Plane_2601.two_protons_golden.convert2h5'

-
  name: 'Shield_Plane_2601.two_protons_golden.flow.{{mode}}'
  env:
    <<: *common_flow_ndlar
    ND_PRODUCTION_IN_NAME: 'Shield_Plane_2601.two_protons_golden.larnd.{{mode}}'

-
  name: 'Shield_Plane_2601.two_protons_golden.flow2supera.{{mode}}'
  env:
    <<: *common_flow2supera_ndlar
    ND_PRODUCTION_IN_NAME: 'Shield_Plane_2601.two_protons_golden.flow.{{mode}}'

-
  name: 'Shield_Plane_2601.two_protons_golden.spine.{{mode}}'
  env:
    <<: *common_spine_ndlar
    ND_PRODUCTION_IN_NAME: 'Shield_Plane_2601.two_protons_golden.flow2supera.{{mode}}'

{% endfor %}
